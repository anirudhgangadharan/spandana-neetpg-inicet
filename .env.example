# Runtime database (Neon/Postgres). Never use this variable in migration commands.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Auth.js. AUTH_SECRET and the sweep secret must be at least 32 characters.
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=replace-with-google-oauth-client-id
AUTH_GOOGLE_SECRET=replace-with-google-oauth-client-secret

# Stable Google `sub` claim for the sole super-admin. Do not identify this role by email.
SUPER_ADMIN_GOOGLE_SUB=replace-with-google-provider-subject

# Bearer secret used only by POST /api/internal/module-attempts/expire.
ATTEMPT_SWEEP_SECRET=replace-with-an-independent-long-random-secret

# Public operator identity and contact rendered by /privacy. Readiness fails when absent.
PRIVACY_OPERATOR_NAME=replace-with-operator-legal-name
PRIVACY_CONTACT_EMAIL=privacy@example.org

# Optional, legacy editorial-note writers. This does not grant faculty access.
ADMIN_EMAILS=

# Optional runtime directory containing corpus.sqlite, manifest.json, and facets.json.
CORPUS_DIR=

# Migration-only variables. Leave unset during normal application runtime.
MIGRATION_DATABASE_URL=
MIGRATION_TARGET=
